# ==========================================================
# kameralnybarbershop.pl — konfiguracja dla hostingu OVHcloud
# (Apache. Plik wgrywamy do katalogu www/ razem z resztą strony.)
# ==========================================================

RewriteEngine On

# --- 1. Wymuś HTTPS -------------------------------------------------
# OVH przekazuje informację o HTTPS w nagłówku X-Forwarded-Proto.
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://kameralnybarbershop.pl/$1 [R=301,L]

# --- 2. www -> bez www ----------------------------------------------
# Jedna wersja adresu = brak duplikatów w Google.
RewriteCond %{HTTP_HOST} ^www\.kameralnybarbershop\.pl$ [NC]
RewriteRule ^(.*)$ https://kameralnybarbershop.pl/$1 [R=301,L]

# --- 3. Strona główna bez /index.html -------------------------------
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# --- 4. Kompresja ---------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 5. Cache przeglądarki ------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType image/svg+xml           "access plus 6 months"
  # HTML krótko — żeby zmiany na stronie były widoczne od razu
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# --- 6. Podstawowe nagłówki bezpieczeństwa --------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# --- 7. Kodowanie ---------------------------------------------------
AddDefaultCharset UTF-8

# --- 8. Ukryj pliki techniczne --------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
